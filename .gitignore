### Raziel voice assistant — files that must never be pushed to GitHub ###

# --- Secrets: API keys, tokens, phone numbers ---
config.py
google_credentials.json
google_token.json
.spotify_cache

# --- Personal data / runtime state ---
memory.db
assistant.log
*.log
temp_recording.wav
generated_files/
screenshots/
my_voice/
avatar_transparency.json
avatar_place.json
gestures_state.json
voice_profile.npz
file_index.db
file_index.db-wal
file_index.db-shm

# --- Large binary models (over/near GitHub's 100MB file limit, and not code) ---
*.onnx
*.onnx.json
*.vrm
models/

# --- Python environment (regenerate with requirements.txt) ---
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# --- Backups made during earlier dev sessions, and old test bundles ---
_backup_before_*/
tests_v3.zip

# --- Local working notes - not part of the app itself ---
Claude outputs/

# --- OS/editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
media_duck.json
spotify_playlists.json
gestures_debug.jsonl
gestures_debug.old.jsonl
folder_names.json
